# Copy this file to ".env" in this folder and choose your own values.
# ".env" is ignored by git - never commit real credentials.
# docker compose reads ".env" automatically when you run it from this folder.

# Root account that the MongoDB container creates on its first start
MONGO_ROOT_USERNAME=change-me
MONGO_ROOT_PASSWORD=change-me

# Account mongo-express uses to connect to MongoDB. It must exist in MongoDB;
# normally use the same values as the root account above.
# These two are placed in a connection URL: avoid @ : / in them, or URL-encode them.
ME_MONGO_USERNAME=change-me
ME_MONGO_PASSWORD=change-me
